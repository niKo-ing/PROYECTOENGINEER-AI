APP_ENV=development

# Base de datos. Sin DATABASE_URL el backend usa SQLite local (./solotodo.db).
# Para desarrollo con el catálogo de ejemplo: DATABASE_URL=sqlite:///./todobarato.db
# Con PostgreSQL (RDS, Supabase u otro):
# DATABASE_URL=postgresql+psycopg://usuario:[CLAVE]@host:5432/base
DATABASE_URL=

# Alternativa: el backend construye DATABASE_URL si la variable anterior se omite.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Cuentas propias (registro e inicio de sesión en /api/v1/auth). Obligatorio en producción.
# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# AUTH_TOKEN_TTL_SECONDS=604800
# AUTH_RATE_LIMIT_PER_MINUTE=10

# Opcional: si el proyecto vuelve a usar Supabase Auth, el backend también acepta sus tokens.
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated

# Admin: en production debe existir al menos una allowlist.
# Separe múltiples valores con coma.
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# LLM: Gemini es el proveedor del asistente, del armador de PC y de la evaluación.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
# Configuración opcional para cambiar posteriormente a LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_TOOL_CALLS=3

# Ingestion dev limits (0 or empty = no limit, production behavior)
INGESTION_MAX_CATEGORIES=0
INGESTION_MAX_URLS_PER_CATEGORY=0
INGESTION_MAX_PRODUCTS=0
