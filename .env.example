APP_ENV=development

# Opción recomendada: cadena de conexión de Supabase (SQLAlchemy + psycopg).
# Use el host del pooler si su proyecto de Supabase lo requiere.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternativa: el backend construye DATABASE_URL si la variable anterior se omite.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_HOST=db.[YOUR-PROJECT-REF].supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Supabase Auth (la anon key es exclusivamente para el frontend).
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Solo para proyectos Supabase heredados que firman tokens HS256.
# SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# LLM: Gemini es el proveedor por defecto para POST /api/v1/ai/chat.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
# Configuración opcional para cambiar posteriormente a LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_TOOL_CALLS=3
