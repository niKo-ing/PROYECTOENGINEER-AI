# Variables públicas de Supabase requeridas por el frontend.
#
# Se consumen como process.env.NEXT_PUBLIC_* y son INLINEADAS en el cliente
# durante `next build` (no se leen en tiempo de ejecución con `next start`).
# Deben estar presentes en el entorno de build (y de `next dev` para desarrollo).
#
# - Producción: inyectarlas en el build (CI/CD) o en frontend/.env.local
#   (este archivo NO debe contener valores reales ni subirse con secrets).
# - Desarrollo local: copiar estos placeholders a frontend/.env.local con los
#   valores del proyecto. También se pueden exportar en el shell antes de
#   `next build` / `next dev`.
#
# En este repositorio las copias reales viven en el .env de la raíz (junto a las
# del backend). Next.js NO lee el .env de la raíz automáticamente: se cargan desde
# frontend/.env* o desde el entorno del proceso.

NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Variables del backend (solo referencia, definidas en la raíz):
#   SUPABASE_URL           -> validación JWTs del backend (audience "authenticated")
#   SUPABASE_JWT_AUDIENCE  -> por defecto "authenticated"
#   GEMINI_API_KEY, LLM_PROVIDER, GEMINI_MODEL, LLM_TIMEOUT_SECONDS, AI_MAX_TOOL_CALLS