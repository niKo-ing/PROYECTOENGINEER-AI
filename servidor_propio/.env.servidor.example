# Copiar como .env.servidor en cada tarro y completar. NO subir el .env.servidor al repositorio.
APP_ENV=production
NOMBRE_TARRO=tarro1
# En el tarro 2: API_LOCAL=api:8000  API_PAR=192.168.1.11:8000 (IP del tarro 1), y al revés en el tarro 1.
API_LOCAL=api:8000
API_PAR=192.168.1.12:8000
WEB_LOCAL=web:3000
WEB_PAR=192.168.1.12:3000

# Base de datos: la API habla con PgBouncer, que reparte las conexiones a PostgreSQL.
POSTGRES_USER=todobarato
POSTGRES_PASSWORD=
POSTGRES_DB=todobarato
DATABASE_URL=postgresql+psycopg://todobarato:CAMBIAR@pgbouncer:5432/todobarato
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CREATE_ALL=false
AGENT_CHECKPOINT=postgres

# IA propia en la GPU (vLLM) y Gemini como respaldo cuando la GPU está llena o caída.
LLM_PROVIDER=openai
AGENT_LLM_PROVIDER=openai
OPENAI_BASE_URL=http://vllm:8000/v1
OPENAI_MODEL=qwen2.5-7b
MODELO_IA=Qwen/Qwen2.5-7B-Instruct
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_SECONDS=30
# 8 procesos x 4 = 32 consultas a la vez por tarro (= --max-num-seqs de vLLM).
UVICORN_WORKERS=8
AI_MAX_CONCURRENT=4
AI_QUEUE_TIMEOUT_SECONDS=8

# Límites de uso y caché (compartidos vía Redis).
REDIS_URL=redis://redis:6379/0
AI_RATE_LIMIT_PER_HOUR=30
CATALOG_RATE_LIMIT_PER_MINUTE=120
CATALOG_CACHE_TTL_SECONDS=300

# Login (se mantiene Supabase Auth) y administración.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Túnel de Cloudflare (el mismo token en los dos tarros).
CLOUDFLARE_TUNNEL_TOKEN=
